<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For The Single Boy 💌</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: "Poppins", sans-serif;
    background: #09070b;
    color: white;
    overflow-x: hidden;
}

.page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

/* OPEN SCREEN */
#openScreen {
    position: fixed;
    inset: 0;
    z-index: 10;
    background:
        radial-gradient(circle at 50% 40%, #38202f, #09070b 65%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition: 1s ease;
}

.envelope {
    width: 130px;
    height: 95px;
    background: #f4dce7;
    border-radius: 10px;
    position: relative;
    box-shadow: 0 0 35px rgba(255, 180, 210, .25);
    animation: float 2.5s ease-in-out infinite;
}

.envelope:before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    border-left: 65px solid transparent;
    border-right: 65px solid transparent;
    border-top: 48px solid #d99ab5;
}

.heart {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -20%);
    font-size: 28px;
    z-index: 2;
}

.openText {
    margin-top: 30px;
    font-size: 15px;
    letter-spacing: 2px;
    color: #f4dce7;
}

.openBtn {
    margin-top: 20px;
    padding: 13px 28px;
    border: 1px solid #e8aec8;
    background: rgba(255,255,255,.06);
    color: white;
    border-radius: 30px;
    font-size: 15px;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: .3s;
}

.openBtn:hover {
    background: #e8aec8;
    color: #180d14;
    transform: scale(1.05);
}

/* MAIN */
#main {
    display: none;
    padding: 45px 22px;
    text-align: center;
    position: relative;
}

.small {
    color: #dca7bd;
    letter-spacing: 4px;
    font-size: 11px;
    text-transform: uppercase;
}

h1 {
    font-size: clamp(42px, 13vw, 78px);
    margin-top: 12px;
    line-height: .95;
    font-family: Georgia, serif;
    font-weight: 400;
}

h1 span {
    color: #e7a9c2;
    font-style: italic;
}

.subtitle {
    margin: 20px auto;
    max-width: 420px;
    color: #cfc4ca;
    line-height: 1.7;
    font-size: 14px;
}

/* CARD */
.card {
    max-width: 430px;
    margin: 35px auto;
    padding: 30px 24px;
    border: 1px solid rgba(231,169,194,.25);
    background: rgba(255,255,255,.045);
    border-radius: 25px;
    backdrop-filter: blur(15px);
    box-shadow: 0 15px 50px rgba(0,0,0,.35);
}

.card .emoji {
    font-size: 38px;
    margin-bottom: 15px;
}

.card h2 {
    font-family: Georgia, serif;
    font-weight: 400;
    font-size: 27px;
    margin-bottom: 13px;
}

.card p {
    color: #cfc4ca;
    font-size: 14px;
    line-height: 1.8;
}

/* FUNNY SECTION */
.funny {
    margin: 45px auto;
    max-width: 420px;
}

.funny p {
    margin: 14px 0;
    padding: 14px;
    border-radius: 15px;
    background: rgba(255,255,255,.04);
    color: #ddd0d6;
}

/* END */
.end {
    margin-top: 55px;
    padding-bottom: 50px;
}

.end .bigHeart {
    font-size: 45px;
    animation: pulse 1.5s infinite;
}

.end h3 {
    font-family: Georgia, serif;
    font-size: 28px;
    font-weight: 400;
    margin: 15px 0;
}

.end p {
    color: #aaa0a6;
    font-size: 13px;
    line-height: 1.7;
}

/* FLOATING HEARTS */
.floatHeart {
    position: fixed;
    bottom: -30px;
    font-size: 15px;
    opacity: .7;
    animation: rise linear forwards;
    pointer-events: none;
}

@keyframes rise {
    to {
        transform: translateY(-110vh) rotate(25deg);
        opacity: 0;
    }
}

@keyframes float {
    50% {
        transform: translateY(-10px);
    }
}

@keyframes pulse {
    50% {
        transform: scale(1.15);
    }
}

.fadeIn {
    animation: fade .9s ease forwards;
}

@keyframes fade {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>
</head>

<body>

<!-- OPEN SCREEN -->
<section id="openScreen">
    <div class="envelope">
        <div class="heart">💗</div>
    </div>

    <div class="openText">A LITTLE SOMETHING FOR YOU</div>

    <button class="openBtn" onclick="openPage()">
        Tap to Open 💌
    </button>
</section>


<!-- MAIN PAGE -->
<main id="main">

    <div class="small">03 October • BF Day</div>

    <h1>
        Happy BF Day,<br>
        <span>Single Boy</span> 🫵🏻
    </h1>

    <p class="subtitle">
        Since you don't have a girlfriend to wish you today...
        someone had to do the honours. 😭
    </p>


    <div class="card fadeIn">
        <div class="emoji">🫶🏻</div>

        <h2>Dear Single Boy,</h2>

        <p>
            Happy Boyfriend Day to someone who is currently
            accepting applications for the position. 😂
            <br><br>
            Don't worry though, being single isn't that bad...
            at least you don't have to explain why you replied
            "hmm" after 3 hours. 😭
        </p>
    </div>


    <div class="funny">

        <p>🌷 Relationship status: <b>Under Construction</b></p>

        <p>💌 Girlfriend: <b>404 Not Found</b></p>

        <p>📱 Reply speed: <b>Depends on the mood</b></p>

        <p>🫠 Delusion level: <b>Premium</b></p>

    </div>


    <div class="card fadeIn">

        <div class="emoji">🌙</div>

        <h2>But honestly...</h2>

        <p>
            I hope you always have people around you who make
            you laugh, listen to your nonsense, support you,
            and remind you that you're genuinely worth having
            around.
            <br><br>
            So yeah... no girlfriend today,
            but at least you got this little webpage. 🤍
        </p>

    </div>


    <div class="end">

        <div class="bigHeart">♡</div>

        <h3>Happy BF Day, loser. 😭</h3>

        <p>
            May your single era be peaceful,<br>
            your standards remain questionable,<br>
            and your future girlfriend eventually find you. 😂
        </p>

    </div>

</main>


<script>

function openPage() {

    const screen = document.getElementById("openScreen");
    const main = document.getElementById("main");

    screen.style.opacity = "0";

    setTimeout(() => {
        screen.style.display = "none";
        main.style.display = "block";
        main.classList.add("fadeIn");
    }, 800);

    // start hearts
    setInterval(createHeart, 700);
}

function createHeart() {

    const heart = document.createElement("div");

    heart.className = "floatHeart";

    const emojis = ["♡", "♥", "💗", "🤍", "✦"];

    heart.innerHTML =
        emojis[Math.floor(Math.random() * emojis.length)];

    heart.style.left =
        Math.random() * 100 + "vw";

    heart.style.animationDuration =
        (4 + Math.random() * 5) + "s";

    heart.style.fontSize =
        (10 + Math.random() * 14) + "px";

    document.body.appendChild(heart);

    setTimeout(() => {
        heart.remove();
    }, 9000);
}

</script>

</body>
</html>

